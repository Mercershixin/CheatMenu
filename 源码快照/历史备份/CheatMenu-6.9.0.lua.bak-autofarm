        -- 自杀 / 角色状态(防死亡·防击倒 并入上帝模式)
        NoDeath=false,NoKnock=false,
        -- 瞄准补强(注: 「锁定保持/粘性瞄准」用户早前明确删除过, code 里有回归锁, 不再加回)
        CB_MissMode=false,
        -- 默认关闭的三项(用户点名: 加入但默认关)
